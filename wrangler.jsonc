{
  // Cloudflare Workers static-assets config. The Git-connected build runs
  // `npx wrangler versions upload`, which needs this file to know what to
  // ship: the repo root, minus the files listed in .assetsignore.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "built-by-raffa",
  "compatibility_date": "2026-04-21",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
